<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme_Base" parent="@style/ShrugTV.Basis">
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="theme_context_color_dark">@color/lb_basic_card_content_text_color</item>
        <item name="theme_context_color_highlight">@color/black_content</item>
        <item name="theme_selection">@color/white</item>
        <item name="theme_title_color_dark">@color/lb_basic_card_title_text_color</item>
        <item name="theme_title_color_highlight">@color/black_title</item>
    </style>
    <style name="AppTheme_DarkGrey" parent="@style/AppTheme_SpecialDarkThemes">
        <item name="android:colorBackground">@color/theme_darkgrey_dark</item>
        <item name="android:windowBackground">@color/theme_darkgrey_main_background</item>
        <item name="android:colorPrimaryDark">@color/theme_darkgrey_dark</item>
        <item name="android:statusBarColor">@color/theme_darkgrey_dark</item>
        <item name="theme_color">@color/theme_darkgrey</item>
        <item name="theme_color_dark">@color/theme_darkgrey_dark</item>
        <item name="theme_color_main_background">@color/theme_darkgrey_main_background</item>
    </style>
    <style name="AppTheme_SpecialDarkThemes" parent="@style/AppTheme_Base">
        <item name="android:colorPrimary">?colorPrimary</item>
        <item name="theme_color_bright">?theme_color_bright</item>
        <item name="theme_context_color_dark">@color/white</item>
        <item name="theme_context_color_highlight">@color/white</item>
        <item name="theme_selection">?theme_selection</item>
        <item name="theme_title_color_dark">@color/white</item>
        <item name="theme_title_color_highlight">@color/white</item>
    </style>
    <style name="CustomMainSettingsListRed" parent="@style/PreferenceFragmentList.Leanback">
        <item name="android:background">@color/theme_red_dark</item>
    </style>
    <style name="CustomPreferenceThemeRed" parent="@style/PreferenceThemeOverlay.v14.Leanback">
        <item name="preferenceFragmentListStyle">@style/CustomMainSettingsListRed</item>
    </style>
    <style name="LeanbackPreference">
    </style>
    <style name="LeanbackPreference.Category" parent="@style/LeanbackPreference">
        <item name="android:selectable">false</item>
        <item name="android:shouldDisableView">false</item>
    </style>
    <style name="LeanbackPreference.CheckBoxPreference" parent="@style/LeanbackPreference">
        <item name="android:widgetLayout">@layout/preference_widget_checkbox</item>
    </style>
    <style name="LeanbackPreference.DialogPreference" parent="@style/LeanbackPreference">
        <item name="android:positiveButtonText">@android:string/ok</item>
        <item name="android:negativeButtonText">@android:string/cancel</item>
    </style>
    <style name="LeanbackPreference.DialogPreference.EditTextPreference" parent="@style/LeanbackPreference.DialogPreference">
        <item name="android:dialogLayout">@layout/preference_dialog_edittext</item>
    </style>
    <style name="LeanbackPreference.Information" parent="@style/LeanbackPreference">
        <item name="android:enabled">false</item>
        <item name="android:shouldDisableView">false</item>
    </style>
    <style name="LeanbackPreference.PreferenceScreen" parent="@style/LeanbackPreference" />
    <style name="LeanbackPreference.SeekBarPreference" parent="@style/LeanbackPreference">
        <item name="adjustable">true</item>
        <item name="showSeekBarValue">true</item>
    </style>
    <style name="LeanbackPreference.SwitchPreference" parent="@style/LeanbackPreference">
        <item name="android:widgetLayout">@layout/preference_widget_switch</item>
        <item name="android:switchTextOn">@string/v7_preference_on</item>
        <item name="android:switchTextOff">@string/v7_preference_off</item>
    </style>
    <style name="LeanbackPreference.SwitchPreferenceCompat" parent="@style/LeanbackPreference">
        <item name="android:widgetLayout">@layout/preference_widget_switch_compat</item>
        <item name="android:switchTextOn">@string/v7_preference_on</item>
        <item name="android:switchTextOff">@string/v7_preference_off</item>
    </style>
    <style name="LeanbackPreferencesRed" parent="@style/ShrugTV.Basis">
        <item name="android:colorBackground">@color/theme_red_dark</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorPrimary">@color/theme_red</item>
        <item name="android:colorPrimaryDark">@color/theme_red_dark</item>
        <item name="android:colorAccent">@color/theme_red_bright</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:statusBarColor">@color/theme_red_dark</item>
        <item name="preferenceTheme">@style/CustomPreferenceThemeRed</item>
    </style>
    <style name="PreferenceFragment">
        <item name="android:divider">?android:listDivider</item>
        <item name="android:paddingStart">0.0dp</item>
        <item name="android:paddingEnd">0.0dp</item>
    </style>
    <style name="PreferenceFragment.Leanback" parent="@style/PreferenceFragment">
        <item name="android:divider">@null</item>
    </style>
    <style name="PreferenceFragmentList">
        <item name="android:paddingStart">16.0dp</item>
        <item name="android:paddingEnd">16.0dp</item>
    </style>
    <style name="PreferenceFragmentList.Leanback" parent="@style/PreferenceFragmentList">
        <item name="android:paddingBottom">34.0dp</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingStart">0.0dp</item>
        <item name="android:paddingEnd">0.0dp</item>
    </style>
    <style name="PreferenceThemeOverlay.v14.Leanback" parent="@style/PreferenceThemeOverlayLeanback" />
    <style name="PreferenceThemeOverlayLeanback">
        <item name="checkBoxPreferenceStyle">@style/LeanbackPreference.CheckBoxPreference</item>
        <item name="dialogPreferenceStyle">@style/LeanbackPreference.DialogPreference</item>
        <item name="dropdownPreferenceStyle">@style/Preference.DropDown</item>
        <item name="editTextPreferenceStyle">@style/LeanbackPreference.DialogPreference.EditTextPreference</item>
        <item name="preferenceCategoryStyle">@style/LeanbackPreference.Category</item>
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Leanback</item>
        <item name="preferenceFragmentListStyle">@style/PreferenceFragmentList.Leanback</item>
        <item name="preferenceFragmentStyle">@style/PreferenceFragment.Leanback</item>
        <item name="preferenceInformationStyle">@style/LeanbackPreference.Information</item>
        <item name="preferenceScreenStyle">@style/LeanbackPreference.PreferenceScreen</item>
        <item name="preferenceStyle">@style/LeanbackPreference</item>
        <item name="seekBarPreferenceStyle">@style/LeanbackPreference.SeekBarPreference</item>
        <item name="switchPreferenceCompatStyle">@style/LeanbackPreference.SwitchPreferenceCompat</item>
        <item name="switchPreferenceStyle">@style/LeanbackPreference.SwitchPreference</item>
    </style>
    <!-- Eigene Basis aller View-Themes; vorher die Kopie Theme.Leanback/LeanbackBase -->
    <style name="ShrugTV.Basis" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowOverscan">true</item>
        <item name="android:colorPrimary">@color/lb_default_brand_color</item>
        <item name="android:colorPrimaryDark">@color/lb_default_brand_color_dark</item>
        <item name="android:colorAccent">@color/lb_preference_item_category_text_color</item>
        <item name="android:windowTransitionBackgroundFadeDuration">350</item>
    </style>
    <style name="ThemeAccent.DarkGrey.Purple" parent="@style/AppTheme_DarkGrey">
        <item name="colorPrimary">@color/new_twitch_purple</item>
        <item name="theme_color_bright">@color/new_twitch_purple</item>
        <item name="theme_selection">@color/new_twitch_purple</item>
    </style>
</resources>
